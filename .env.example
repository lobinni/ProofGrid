# ProofGrid active deployment configuration
# Copy to .env.local for local development, or configure the same values in
# Vercel Project Settings and redeploy. The committed deployment manifest is
# the audited fallback when these variables are absent.

# GenLayer Studio / Studionet (chain 61999)
NEXT_PUBLIC_STUDIONET_FACTORY=0xfB0dF18C4c55179Bb57Bbbe48AE2d61Dc282043E

# Asimov / Bradbury Testnet (chain 4221)
NEXT_PUBLIC_BRADBURY_FACTORY=0x503Bdaed62C1419516052Eb5cE55d4cE6210f67D

# studionet | bradbury
NEXT_PUBLIC_DEFAULT_NETWORK=studionet

# Funded keys are only for the CLI lifecycle demonstration. Never prefix these
# with NEXT_PUBLIC, configure them in Vercel, or commit real values.
# CREATOR_PRIVATE_KEY=0x...
# WORKER_PRIVATE_KEY=0x...
